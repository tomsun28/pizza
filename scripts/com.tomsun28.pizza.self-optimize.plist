<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tomsun28.pizza.self-optimize</string>

    <!-- Every 30 minutes (1800 seconds). -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- Also fire shortly after load (so you don't wait up to 30 min). -->
    <key>RunAtLoad</key>
    <false/>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/tom/code/agent/pizza/scripts/auto-self-optimize.sh</string>
    </array>

    <!-- Minimal environment (launchd does NOT inherit your shell PATH). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/tom</string>
        <!-- Uncomment to pin a model (e.g. a cheap/fast one for the periodic pass): -->
        <!-- <key>PIZZA_MODEL</key><string>openai/gpt-4o-mini</string> -->
    </dict>

    <!-- Keep logging out of the way; the script also writes a per-run log. -->
    <key>StandardOutPath</key>
    <string>/Users/tom/code/agent/pizza/.pizza-auto-optimize/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tom/code/agent/pizza/.pizza-auto-optimize/launchd.err.log</string>

    <!-- Don't auto-restart on exit; we only want the 30-min cadence. -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
