{
	"name": "@tomsun28/pizza-channel-webhook",
	"version": "0.2.4",
	"private": true,
	"description": "Generic webhook channel relay for Pizza — an HTTP endpoint that delivers inbound POSTs into a workspace agent and returns the reply as JSON. No external SDK.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"clean": "shx rm -rf dist"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/tomsun28/pizza.git",
		"directory": "packages/channels/webhook"
	},
	"dependencies": {
		"@tomsun28/pizza-channel-core": "*"
	},
	"devDependencies": {
		"shx": "^0.4.0",
		"typescript": "^5.7.3"
	}
}